[Unit]
Description=OpenMannin - provenance-first Isle of Man map
Documentation=https://github.com/OWNER/openmannin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openmannin
Group=openmannin
WorkingDirectory=/opt/openmannin

# The only runtime setting scripts/serve.mjs reads.
Environment=PORT=3000

# systemd does not run ExecStart through a shell, so it uses neither your
# interactive PATH nor a version manager shims. Pin a sane PATH and resolve node
# through env, because where node lives depends on how it was installed:
# /usr/bin/node from a distro package, /usr/local/bin/node from the official
# tarball, or a mise/asdf/nvm path.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Overrides for the above. Create /etc/default/openmannin (chmod 640, owned by
# root) if node lives somewhere unusual, e.g.
#   NODE_BIN=/home/user/.local/share/mise/installs/node/22.11.0/bin/node
EnvironmentFile=-/etc/default/openmannin

# WHAT THIS SERVES. out/ - the static export produced by `npm run build` - via
# scripts/serve.mjs, a zero-dependency file server that also applies the
# security headers Cloudflare Pages would apply to the same files. There is no
# Next server: `next start` refuses to serve an `output: "export"` build, which
# is exactly the bug this unit exists to not have.
#
# THERE ARE NO ENVIRONMENT VARIABLES FOR THE LIVE FEEDS, and no secrets are
# needed to run this service. Satellite passes are fetched by the BROWSER
# straight from CelesTrak. Feeds that would need a server or whose licence is
# not free for commercial use (OpenSky, AISStream, FindMyBus, Open-Meteo
# weather, Met Office) have been removed from src/lib/feeds/index.ts: no
# requests are made and nothing is configured. If a doc tells you to set
# AISSTREAM_API_KEY for this unit, that doc is describing a version of the app
# that no longer has /api/marine.
#
# To change the port:
#   systemctl edit openmannin     # and add Environment=PORT=8080 under [Service]
#   systemctl restart openmannin

# The file server itself, invoked through node directly rather than via npm.
# `npm run start` would work but adds a shell wrapper and a package.json lookup
# for no benefit, and a wrong npm path fails far more confusingly than a missing
# node does.
ExecStart=/usr/bin/env node /opt/openmannin/scripts/serve.mjs
Restart=always
RestartSec=5

# ---- hardening ------------------------------------------------------------
# The unit only reads its own directory; nothing writes, and no outbound
# requests are made from this host at all (tiles and client feeds are fetched
# by the browser of whoever is looking at the map).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# False on purpose: V8's JIT needs writable+executable pages, and setting this
# to true makes node die on startup with a SIGSEGV rather than fail a check.
MemoryDenyWriteExecute=false

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openmannin

[Install]
WantedBy=multi-user.target

# ---- first install ---------------------------------------------------------
#   sudo useradd --system --home /opt/openmannin --shell /usr/sbin/nologin openmannin
#   sudo -u openmannin git clone <repo> /opt/openmannin
#   cd /opt/openmannin
#   sudo -u openmannin npm ci
#   sudo -u openmannin npm run ingest:all      # only if public/data is empty
#   sudo -u openmannin npm run build           # writes out/, incl. health.json
#   sudo cp deploy/openmannin.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now openmannin
#   curl -s localhost:3000/health.json | python3 -m json.tool
#
# The ingest step is the fragile one: it calls Overpass, CelesTrak and gov.im,
# all of which rate-limit. If it fails, re-run it rather than deploying.
#
# systemd-analyze verify checks this unit resolves - run it on your target host:
#   systemd-analyze verify /etc/systemd/system/openmannin.service
#
# Upgrading: repeat the npm ci / ingest / build steps, then
#   sudo systemctl restart openmannin
#
# NOTE: deploy/nginx.conf sits in front of this on a VPS and serves out/
# directly with its own root - it does NOT proxy to this unit. Point root at
# /opt/openmannin/out there, and you may stop this service entirely; the unit
# is for hosts without nginx.
