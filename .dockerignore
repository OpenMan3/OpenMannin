# Build artefacts and dependencies are produced inside the image.
node_modules
.next
out
.tsbuildinfo
.git
.gitignore

# public/data is deliberately NOT ignored, because the SKIP_INGEST=1 path needs
# it: excluding it here made that flag impossible to satisfy (the manifest test
# could never pass, since the manifest was also filtered out of the context).
# The default build ignores whatever copy arrives and re-runs ingest anyway, so
# stale data cannot ship by accident - only by asking for it explicitly with
# --build-arg SKIP_INGEST=1, which is the flag's whole contract.

# Copied from node_modules at build time by scripts/copy-maplibre-worker.mjs,
# and regenerated before every build by the *-worker.mjs builders.
public/maplibre-gl-worker.mjs
public/maplibre-gl-shared.mjs
public/passes-worker.mjs
public/routing-worker.mjs

# Local env and editor noise.
.env
.env.local
.env.*.local
.DS_Store
*.swp
.idea
.vscode
*.tsbuildinfo

# Verification artefacts and local caches.
smoke.png
.wrangler
