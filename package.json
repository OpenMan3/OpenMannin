{
  "name": "openmannin",
  "version": "0.2.0",
  "private": true,
  "description": "OpenMannin \u2014 Open Source Intelligence Reconnaissance & Infrastructure System for the Isle of Man",
  "type": "module",
  "scripts": {
    "copy:worker": "node scripts/copy-maplibre-worker.mjs",
    "dev": "npm run copy:worker && npm run build:passes-worker && npm run build:routing-worker && next dev",
    "build": "npm run copy:worker && npm run build:passes-worker && npm run build:routing-worker && npm run build:headers && npm run build:search && npm run build:health && npm run build:manifest && next build",
    "start": "node scripts/serve.mjs",
    "build:headers": "node scripts/static-headers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --no-warnings --test scripts/lib/*.test.mjs",
    "ingest:osminfra": "node --experimental-strip-types --no-warnings scripts/ingest-osm-infra.mjs",
    "ingest:osmlayers": "node --experimental-strip-types --no-warnings scripts/fetch-osm-layers.ts",
    "ingest:wikidata": "node --experimental-strip-types --no-warnings scripts/ingest-wikidata-heritage.mjs",
    "ingest:busstops": "node --experimental-strip-types --no-warnings scripts/ingest-busstops.mjs",
    "ingest:housenumbers": "node --experimental-strip-types --no-warnings scripts/ingest-housenumbers.mjs",
    "ingest:postcodes": "node scripts/ingest-postcodes.mjs",
    "ingest:airports": "node scripts/ingest-airports.mjs",
    "ingest:cables": "node scripts/ingest-cables.mjs",
    "ingest:tidestations": "node scripts/ingest-tidestations.mjs",
    "ingest:dumpsites": "node scripts/ingest-dumpsites.mjs",
    "ingest:offshorewind": "node scripts/ingest-offshorewind.mjs",
    "ingest:ports": "node scripts/ingest-ports.mjs",
    "ingest:power": "node scripts/ingest-power.mjs",
    "ingest:satellite": "node scripts/ingest-satellite-stations.mjs",
    "ingest:comms-towers": "node --experimental-strip-types --no-warnings scripts/ingest-comms-towers.mjs",
    "ingest:wifi": "node --experimental-strip-types --no-warnings scripts/ingest-wifi.mjs",
    "ingest:parishes": "node --experimental-strip-types --no-warnings scripts/ingest-parishes.mjs",
    "ingest:update": "node --experimental-strip-types --no-warnings scripts/update-data.mjs --no-build",
    "ingest:all": "npm run ingest:osminfra && npm run ingest:osm && npm run ingest:osmlayers && npm run ingest:wikidata && npm run ingest:airports && npm run ingest:cables && npm run ingest:tidestations && npm run ingest:dumpsites && npm run ingest:offshorewind && npm run ingest:ports && npm run ingest:power && npm run ingest:satellite && npm run ingest:busstops && npm run ingest:housenumbers && npm run ingest:postcodes && npm run ingest:comms-towers && npm run ingest:overture && npm run ingest:wifi && npm run ingest:update && npm run ingest:parishes && npm run annotate:nearest && npm run build:manifest && npm run build:search",
    "ingest:osm": "node scripts/ingest-osm.mjs",
    "verify:registry": "node --experimental-strip-types --no-warnings scripts/verify-registry.mjs",
    "verify:data-quality": "node --experimental-strip-types --no-warnings scripts/verify-data-quality.mjs",
    "verify:freshness": "node --experimental-strip-types --no-warnings scripts/verify-freshness.mjs",
    "ingest:wikidata-memorials": "node --experimental-strip-types --no-warnings scripts/ingest-wikidata-memorials.mjs",
    "verify:render": "node scripts/verify-render.mjs",
    "verify:basemap": "node scripts/verify-basemap.mjs",
    "build:manifest": "node --experimental-strip-types --no-warnings scripts/build-manifest.mjs",
    "update-data": "node --experimental-strip-types --no-warnings scripts/update-data.mjs",
    "build:sources": "node --experimental-strip-types --no-warnings scripts/build-sources.mjs",
    "build:search": "node --experimental-strip-types --no-warnings scripts/build-search-index.mjs",
    "annotate:nearest": "node --experimental-strip-types --no-warnings scripts/annotate-nearest-place.mjs",
    "build:health": "node scripts/build-health.mjs",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "build:passes-worker": "node scripts/build-passes-worker.mjs",
    "build:routing-worker": "node scripts/build-routing-worker.mjs",
    "ingest:overture": "node --experimental-strip-types --no-warnings scripts/ingest-overture-places.mjs",
    "smoke:navigation": "node --experimental-strip-types --no-warnings scripts/smoke-navigation.mjs",
    "verify:sidebar": "node scripts/verify-sidebar.mjs",
    "verify:offline": "node scripts/verify-offline.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.14.0",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "proj4": "^2.22.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  }
}
